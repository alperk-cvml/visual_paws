# Phase 1 depth model comparison profile (Gazebo).
#
# Compares the Gazebo depth sensor against three monocular metric depth models
# on identical frames. Paired with docker-compose-depth-comparison.yaml.

# Gazebo publishes /clock; every node must follow it.
USE_SIM_TIME=true

# Ground truth localisation: Gazebo owns odom->base_link and publishes a static
# map->odom. The comparison needs a TF tree for RViz, not drift correction, so
# there is no reason to pay for the EKF/ORB-SLAM3 stack here.
LOCALIZATION_MODE=ground_truth

# ── Comparison inputs ────────────────────────────────────────────────────
# Gazebo's RGB camera. The ground-truth depth sensor is wired separately, via
# the `gt` relay channel in src/depth_comparison/config/backends.yaml.
COMPARE_INPUT_IMAGE_TOPIC=/front_camera/image_raw
COMPARE_INPUT_CAMERA_INFO_TOPIC=/front_camera/camera_info

# All four channels: ground truth plus the three models.
# Drop channels to keep the loop responsive, e.g.
#   COMPARE_BACKENDS=gt,dav2_vkitti,dav2_hypersim
COMPARE_BACKENDS=gt,dav2_vkitti,dav2_hypersim,metric3d_s

COMPARE_NAMESPACE=/depth_compare
COMPARE_PUBLISH_POINTCLOUDS=true
DEVICE=cuda

# Upper bound, not a promise. Measured on an RTX 2060 the three models cost
# ~1.8 s/frame combined (~0.55 Hz), dominated by Metric3D's fixed 616x1064
# canonical resolution. 1.0 keeps the request close to achievable throughput;
# the node drops whatever it cannot keep up with either way.
COMPARE_TARGET_FPS=1.0

# ── RViz ─────────────────────────────────────────────────────────────────
# The stock config has no /depth_compare displays — add four PointCloud2
# displays (one per channel) with Fixed Frame `odom`, or point RVIZ_CONFIG at
# a saved config of your own.
RVIZ_CONFIG=/work/ws/src/rviz/config/visual_paws.rviz
