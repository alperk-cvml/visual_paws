# Live depth-scale probe profile (Gazebo, ground-truth localisation).
#
# Runs the production Metric3D V2 node (monocular_depth) — not the
# depth_comparison harness — against ground_plane_estimation to test whether
# monocular depth error behaves as a per-frame scale factor. Paired with
# docker-compose-depth-scale-probe.yaml.

# Gazebo publishes /clock; every node must follow it.
USE_SIM_TIME=true

# Ground truth localisation: Gazebo owns odom->base_link and publishes a
# static map->odom, so `odom`'s z=0 plane is the true ground. This is what
# makes GROUND_PLANE_HEIGHT_REFERENCE_FRAME=odom below valid — see
# src/ground_plane_estimation/README.md's Caveats section before reusing
# this profile's settings anywhere localisation drifts (SLAM, offline video).
LOCALIZATION_MODE=ground_truth

# ── Deterministic simulation benchmark ──────────────────────────────────
# Same V0 scenario as depth-comparison.env, so results are comparable.
SIM_BENCHMARK_SCENARIO=v0_geometry
SIM_BENCHMARK_SEED=config
SIM_BENCHMARK_OUTPUT_DIR=/work/ws/build/simulation_benchmark

GAZEBO_LAUNCH_FILE=simulation_benchmark.launch.py
GAZEBO_LAUNCH_ARGS=scenario:=${SIM_BENCHMARK_SCENARIO:-v0_geometry} seed:=${SIM_BENCHMARK_SEED:-config} output_dir:=${SIM_BENCHMARK_OUTPUT_DIR:-/work/ws/build/simulation_benchmark}

# ── monocular_depth (Metric3D V2) ────────────────────────────────────────
# Gazebo's RGB camera in place of the real /camera/image_raw default.
INPUT_IMAGE_TOPIC=/front_camera/image_raw
INPUT_CAMERA_INFO_TOPIC=/front_camera/camera_info
OUTPUT_DEPTH_TOPIC=/depth/image_raw
OUTPUT_CAMERA_INFO_TOPIC=/depth/camera_info
MODEL_NAME=metric3d_vit_small
MAX_DEPTH=300.0
TARGET_FPS=5.0
DEVICE=cuda

# ── depth_image_proc ──────────────────────────────────────────────────────
# Bridges monocular_depth's depth image into the PointCloud2 that
# ground_plane_estimation (and RViz) consume.
DEPTH_IMAGE_TOPIC=/depth/image_raw
DEPTH_CAMERA_INFO_TOPIC=/depth/camera_info
POINTCLOUD_TOPIC=/depth/points

# ── ground_plane_estimation ─────────────────────────────────────────────
# Single channel: the live Metric3D point cloud. `odom` is a valid ground
# reference only because LOCALIZATION_MODE=ground_truth above keeps it flat
# and driftless.
GROUND_PLANE_INPUT_TOPICS=/depth/points
GROUND_PLANE_NAMESPACE=/ground_plane
GROUND_PLANE_BASE_FRAME=base_link
GROUND_PLANE_HEIGHT_REFERENCE_FRAME=odom
GROUND_PLANE_TARGET_FPS=5.0

# ── pointcloud_scale_correction ─────────────────────────────────────────
# Applies the probe's estimate back onto the cloud. In this ground-truth
# profile /depth/points_corrected should land on the true geometry — compare
# both clouds in RViz to validate the scalar-error hypothesis end to end.
SCALE_CORRECTION_INPUT_TOPICS=/depth/points
SCALE_CORRECTION_SCALE_TOPICS=/ground_plane/scale
SCALE_CORRECTION_MODEL=scalar
SCALE_CORRECTION_SMOOTHING=ema
SCALE_CORRECTION_EMA_ALPHA=0.2
SCALE_CORRECTION_STALE_POLICY=hold

# ── RViz ─────────────────────────────────────────────────────────────────
# The stock config has no /depth/points or /ground_plane/marker displays —
# add a PointCloud2 display for /depth/points and a Marker display for
# /ground_plane/marker with Fixed Frame `odom`, or point RVIZ_CONFIG at a
# saved config of your own.
RVIZ_CONFIG=/work/ws/src/rviz/config/visual_paws.rviz
