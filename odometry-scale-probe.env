# Odometry scale probe profile (Gazebo, ground-truth localisation).
#
# Alternative 2 from the Current Target: estimate the monocular depth scale
# from MOTION rather than ground geometry. KISS-ICP fed the Metric3D point
# cloud inherits that cloud's scale error, so comparing its odometry against
# the metric leg-kinematics + IMU odometry recovers the scale factor.
# Paired with docker-compose-odometry-scale-probe.yaml.

# Gazebo publishes /clock; every node must follow it.
USE_SIM_TIME=true

# Ground truth localisation: Gazebo owns odom->base_link and publishes a
# static map->odom, so robot_state_publisher's base_link->camera_link_optical
# extrinsic is available to lidar_odometry and no EKF/ORB-SLAM3 competes for
# TF edges. It also publishes /odom_ground_truth, which this profile uses as
# a free health check on the reference odometry (see below).
LOCALIZATION_MODE=ground_truth

# ── Deterministic simulation benchmark ──────────────────────────────────
# Same V0 scenario as depth-comparison.env / depth-scale-probe.env, so
# results are comparable across all three probes.
SIM_BENCHMARK_SCENARIO=v0_geometry
SIM_BENCHMARK_SEED=config
SIM_BENCHMARK_OUTPUT_DIR=/work/ws/build/simulation_benchmark

GAZEBO_LAUNCH_FILE=simulation_benchmark.launch.py
GAZEBO_LAUNCH_ARGS=scenario:=${SIM_BENCHMARK_SCENARIO:-v0_geometry} seed:=${SIM_BENCHMARK_SEED:-config} output_dir:=${SIM_BENCHMARK_OUTPUT_DIR:-/work/ws/build/simulation_benchmark}

# ── monocular_depth (Metric3D V2) ────────────────────────────────────────
# Gazebo's RGB camera in place of the real /camera/image_raw default.
# TARGET_FPS is an UPPER BOUND the node will not reach: Metric3D measures
# ~1.2-1.5 s/frame at 640x480 on an RTX 2060, so expect ~0.7-0.8 Hz. That
# rate is what KISS-ICP downstream has to track with — drive slowly (see the
# compose file's header).
INPUT_IMAGE_TOPIC=/front_camera/image_raw
INPUT_CAMERA_INFO_TOPIC=/front_camera/camera_info
OUTPUT_DEPTH_TOPIC=/depth/image_raw
OUTPUT_CAMERA_INFO_TOPIC=/depth/camera_info
MODEL_NAME=metric3d_vit_small
MAX_DEPTH=300.0
TARGET_FPS=5.0
DEVICE=cuda

# ── depth_image_proc ──────────────────────────────────────────────────────
# Bridges monocular_depth's depth image into the PointCloud2 that KISS-ICP
# (and RViz) consume. The cloud inherits the image's camera_link_optical
# frame and stamp — never restamp or reframe it.
DEPTH_IMAGE_TOPIC=/depth/image_raw
DEPTH_CAMERA_INFO_TOPIC=/depth/camera_info
POINTCLOUD_TOPIC=/depth/points

# ── quadruped_leg_odometry (the metric reference) ────────────────────────
# This is the "IMU and leg odometry" half of Alternative 2 and is REQUIRED,
# not optional: the gait controller publishes joint commands only, so
# /odom_lko comes from this node. TF stays off — Gazebo owns odom->base_link
# in ground_truth mode, and each TF edge has exactly one publisher.
JOINT_STATES_TOPIC=/joint_states
IMU_TOPIC=/imu/data
ODOM_LKO_TOPIC=/odom_lko
LKO_PUBLISH_TF=false

# ── lidar_odometry (KISS-ICP on the MONOCULAR cloud) ─────────────────────
# The point of the profile: ICP on a uniformly scaled world estimates a
# uniformly scaled motion, so /odom_lidar carries Metric3D's scale error.
# Range gate is in CLOUD UNITS (i.e. pre-correction) — if Metric3D's scale is
# far from 1 the true-metric gate moves with it, so keep max_range generous
# rather than tight. Deskew stays off: depth_image_proc clouds carry no
# per-point time field. TF stays off for the same reason as LKO above.
LIDAR_POINTCLOUD_TOPIC=/depth/points
LIDAR_ODOM_TOPIC=/odom_lidar
LIDAR_MAX_RANGE=20.0
LIDAR_MIN_RANGE=0.3
LIDAR_DESKEW=false
LIDAR_ODOM_PUBLISH_TF=false

# ── odometry_scale_estimation (the probe) ────────────────────────────────
# Two estimate channels against the one /odom_lko reference:
#   /odom_scale/odom_lidar/scale        <- THE MEASUREMENT: Metric3D's scale
#   /odom_scale/odom_ground_truth/scale <- free health check on the reference
#                                          (truth vs LKO; should sit at 1.0,
#                                          and its deviation is LKO's own
#                                          error — the probe's noise floor)
# Window is 10 s rather than the 5 s default because the estimate stream runs
# at Metric3D's ~0.75 Hz: a 5 s window would hold only ~4 samples. The cost
# is more accumulated LKO drift inside each window — shorten it if the depth
# node gets faster (TensorRT) or if the scale is visibly time-varying.
ODOM_SCALE_REFERENCE_TOPIC=/odom_lko
ODOM_SCALE_ESTIMATE_TOPICS=/odom_lidar,/odom_ground_truth
ODOM_SCALE_NAMESPACE=/odom_scale
ODOM_SCALE_MODEL=scalar
ODOM_SCALE_WINDOW=10.0
ODOM_SCALE_MIN_MOTION=0.1
ODOM_SCALE_PUBLISH_RATE=2.0
ODOM_SCALE_TIME_OFFSET=0.0
ODOM_SCALE_MARKER_FRAME=odom
ODOM_SCALE_BASE_FRAME=base_link

# ── pointcloud_scale_correction ─────────────────────────────────────────
# Applies the motion-derived estimate back onto the cloud, republishing
# /depth/points_corrected for side-by-side RViz comparison.
#
# Note the namespaced scale topic — two estimate channels above means the
# probe publishes under /odom_scale/<key>/, not /odom_scale/ directly.
#
# The long timeout and `hold` policy matter more here than in the
# ground-plane profile: this probe is INTERMITTENT BY DESIGN — it publishes
# nothing while the robot stands still (no motion, no observable), so a short
# timeout would drop clouds every time you stop driving. `hold` keeps the last
# good estimate through those gaps; `median` smoothing rejects a single bad
# ICP window without the lag of a long EMA.
SCALE_CORRECTION_INPUT_TOPICS=/depth/points
SCALE_CORRECTION_SCALE_TOPICS=/odom_scale/odom_lidar/scale
SCALE_CORRECTION_MODEL=scalar
SCALE_CORRECTION_SMOOTHING=median
SCALE_CORRECTION_MEDIAN_WINDOW=5
SCALE_CORRECTION_ESTIMATE_TIMEOUT=30.0
SCALE_CORRECTION_STALE_POLICY=hold

# ── RViz ─────────────────────────────────────────────────────────────────
# The stock config has none of this profile's displays — with Fixed Frame
# `odom`, add: PointCloud2 on /depth/points and /depth/points_corrected,
# MarkerArray on /odom_scale/odom_lidar/marker (trajectory overlay + the two
# motion-vector arrows), and Odometry displays on /odom_lko + /odom_lidar.
# Or point RVIZ_CONFIG at a saved config of your own.
RVIZ_CONFIG=/work/ws/src/rviz/config/visual_paws.rviz
