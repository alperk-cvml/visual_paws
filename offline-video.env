# Standalone offline-video elevation mapping profile.
USE_SIM_TIME=false
LOCALIZATION_MODE=offline_video
MODE=RGBD
ENABLE_VIEWER=true

# Play once: looping would reset image motion while retaining the SLAM map.
VIDEO_PATH=/work/ws/videos/INPUT_1.MOV
VIDEO_LOOP=false
VIDEO_FPS=10.0
# Allows ORB vocabulary and depth model loading to complete before playback.
VIDEO_START_DELAY=20.0

# Metric3D V2 -> depth_image_proc -> elevation_mapping_cupy.
#
# Metric3D takes its metric scale from the camera focal length, so the depth
# published here is only as correct as video_camera_sim's FX. For recorded
# phone footage, set FX (and FY/CX/CY/WIDTH/HEIGHT) to that camera's real
# calibration rather than leaving the default in place — a wrong FX scales
# every depth value, and the point cloud with it, by the same factor.
INPUT_IMAGE_TOPIC=/camera/image_raw
INPUT_CAMERA_INFO_TOPIC=/camera/camera_info
OUTPUT_DEPTH_TOPIC=/depth/image_raw
OUTPUT_CAMERA_INFO_TOPIC=/depth/camera_info
DEPTH_IMAGE_TOPIC=/depth/image_raw
DEPTH_CAMERA_INFO_TOPIC=/depth/camera_info
POINTCLOUD_TOPIC=/depth_camera/points

# ORB-SLAM directly owns map->base_link in this profile.
MAP_FRAME_ID=map
FRAME_ID=camera_link_optical
