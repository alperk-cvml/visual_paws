# Standalone offline-video elevation mapping profile.
USE_SIM_TIME=false
LOCALIZATION_MODE=offline_video
MODE=RGBD
ENABLE_VIEWER=true

# Play once: looping would reset image motion while retaining the SLAM map.
VIDEO_PATH=/work/ws/videos/INPUT.MOV
VIDEO_LOOP=false
VIDEO_FPS=10.0
# Allows ORB vocabulary and depth model loading to complete before playback.
VIDEO_START_DELAY=20.0

# Depth Anything V2 -> depth_image_proc -> elevation_mapping_cupy.
INPUT_IMAGE_TOPIC=/camera/image_raw
OUTPUT_DEPTH_TOPIC=/depth/image_raw
OUTPUT_CAMERA_INFO_TOPIC=/depth/camera_info
DEPTH_IMAGE_TOPIC=/depth/image_raw
DEPTH_CAMERA_INFO_TOPIC=/depth/camera_info
POINTCLOUD_TOPIC=/depth_camera/points

# ORB-SLAM directly owns map->base_link in this profile.
MAP_FRAME_ID=map
FRAME_ID=camera_link_optical
