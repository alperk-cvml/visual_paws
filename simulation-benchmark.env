# V0 deterministic geometry benchmark profile.
# Paired with docker-compose-simulation-benchmark.yaml.

USE_SIM_TIME=true
LOCALIZATION_MODE=ground_truth

# The `config` value uses `random_seed` from the scenario YAML (currently 42).
# Set a value here or export SIM_BENCHMARK_SEED before `docker compose` to
# deliberately generate another reproducible terrain.
SIM_BENCHMARK_SCENARIO=v0_geometry
SIM_BENCHMARK_SEED=config
SIM_BENCHMARK_OUTPUT_DIR=/work/ws/build/simulation_benchmark

GAZEBO_LAUNCH_FILE=simulation_benchmark.launch.py
GAZEBO_LAUNCH_ARGS=scenario:=${SIM_BENCHMARK_SCENARIO:-v0_geometry} seed:=${SIM_BENCHMARK_SEED:-config} output_dir:=${SIM_BENCHMARK_OUTPUT_DIR:-/work/ws/build/simulation_benchmark}

# Gazebo ground-truth depth -> depth_image_proc -> elevation mapping.
DEPTH_IMAGE_TOPIC=/depth_camera/depth_image
DEPTH_CAMERA_INFO_TOPIC=/depth_camera/camera_info
POINTCLOUD_TOPIC=/depth_camera/points

MAP_LENGTH_X=6.0
MAP_LENGTH_Y=6.0
MAP_RESOLUTION=0.05
PUBLISH_RATE=2.0
