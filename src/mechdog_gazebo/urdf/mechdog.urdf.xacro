<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mechdog">

  <!-- Simple colors -->
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="gray"><color rgba="0.6 0.6 0.6 1"/></material>

  <!-- Base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.18 0.10"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.18 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.10" iyz="0.0" izz="0.12"/>
    </inertial>
  </link>

  <!-- Four simple legs (fixed joints for now) -->
  <xacro:macro name="leg" params="prefix x y">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="${x} ${y} 0.08" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.16"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="${x} ${y} 0.08" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.02" length="0.16"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${x} ${y} 0.08" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
      </inertial>
    </link>

    <joint name="${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- front-left, front-right, rear-left, rear-right -->
  <xacro:leg prefix="fl" x="0.13"  y="0.08"/>
  <xacro:leg prefix="fr" x="0.13"  y="-0.08"/>
  <xacro:leg prefix="rl" x="-0.13" y="0.08"/>
  <xacro:leg prefix="rr" x="-0.13" y="-0.08"/>

</robot>
