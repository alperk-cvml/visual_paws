<?xml version="1.0"?>
<package format="3">
  <name>pointcloud_scale_correction</name>
  <version>0.0.1</version>
  <description>Corrects monocular depth point clouds using the ground-plane scale estimate — pluggable error models (scalar today, affine-ready)</description>

  <maintainer email="kucukkomurler.alper@gmail.com">Alper Kucukkomurler</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
