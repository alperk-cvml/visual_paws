        FL_foot_link:
          Value: true
        FL_hip_link:
          Value: true
        FL_thigh_link:
          Value: true
        FR_calf_link:
          Value: true
        FR_foot_link:
          Value: true
        FR_hip_link:
          Value: true
        FR_thigh_link:
          Value: true
        RL_calf_link:
          Value: true
        RL_foot_link:
          Value: true
        RL_hip_link:
          Value: true
        RL_thigh_link:
          Value: true
        RR_calf_link:
          Value: true
        RR_foot_link:
          Value: true
        RR_hip_link:
          Value: true
        RR_thigh_link:
          Value: true
        base_link:
          Value: true
        camera_link:
          Value: true
        imu_link:
          Value: true
        map:
          Value: true
        odom:
          Value: true
        quadruped:
          Value: true
        quadruped/FL_calf_link:
          Value: true
        quadruped/FL_hip_link:
          Value: true
        quadruped/FL_thigh_link:
          Value: true
        quadruped/FR_calf_link:
          Value: true
        quadruped/FR_hip_link:
          Value: true
        quadruped/FR_thigh_link:
          Value: true
        quadruped/RL_calf_link:
          Value: true
        quadruped/RL_hip_link:
          Value: true
        quadruped/RL_thigh_link:
          Value: true
        quadruped/RR_calf_link:
          Value: true
        quadruped/RR_hip_link:
          Value: true
        quadruped/RR_thigh_link:
          Value: true
        quadruped/base_link:
          Value: true
        quadruped_world:
          Value: true
      Marker Scale: 0.10000000149011612
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        quadruped_world:
          odom:
            {}
          quadruped:
            quadruped/FL_calf_link:
              {}
            quadruped/FL_hip_link:
              {}
            quadruped/FL_thigh_link:
              {}
            quadruped/FR_calf_link:
              {}
            quadruped/FR_hip_link:
              {}
            quadruped/FR_thigh_link:
              {}
            quadruped/RL_calf_link:
              {}
            quadruped/RL_hip_link:
              {}
            quadruped/RL_thigh_link:
              {}
            quadruped/RR_calf_link:
              {}
            quadruped/RR_hip_link:
              {}
            quadruped/RR_thigh_link:
              {}
            quadruped/base_link:
              base_link:
                FL_hip_link:
                  FL_thigh_link:
                    FL_calf_link:
                      FL_foot_link:
                        {}
                FR_hip_link:
                  FR_thigh_link:
                    FR_calf_link:
                      FR_foot_link:
                        {}
                RL_hip_link:
                  RL_thigh_link:
                    RL_calf_link:
                      RL_foot_link:
                        {}
                RR_hip_link:
                  RR_thigh_link:
                    RR_calf_link:
                      RR_foot_link:
                        {}
                camera_link:
                  {}
                imu_link:
                  {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: PointCloud2
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.009999999776482582
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /depth_camera/depth_image/points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: grid_map_rviz_plugin/GridMap
      Color: 200; 200; 200
      Color Layer: elevation
      Color Transformer: GridMapLayer
      Enabled: true
      Height Layer: elevation
      Height Transformer: GridMapLayer
