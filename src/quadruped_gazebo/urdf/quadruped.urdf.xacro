<?xml version="1.0"?>
<!--
  Spot Micro quadruped — URDF/Xacro model for Gazebo Harmonic.

  Geometry follows the open-source Spot Micro (KDY0532 / mike4192 spotMicro):
    0.186 m between front and rear hip pivots, 0.078 m between left and right,
    0.055 m abduction ("shoulder") link, 0.1075 m upper leg, 0.130 m lower leg.
  12 DOF: hip_roll (abduction), hip_pitch, knee per leg. All four knees point
  backward (Spot configuration): the upper leg angles back from the hip and
  the lower leg folds forward under the body, so the knee angle is always
  negative.

  Leg naming: FL / FR / RL / RR (front/rear, left/right).

  The link lengths here are mirrored in python by
  src/quadruped_kinematics/quadruped_kinematics/geometry.py; a unit test in
  that package parses this file and fails if the two disagree. Change the
  geometry in both places or not at all.
-->
<robot name="quadruped" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== GEOMETRY (metres, kg) ===================== -->

  <!-- Leg kinematic parameters — keep in sync with quadruped_kinematics -->
  <xacro:property name="hip_x"       value="0.093"/>   <!-- half the hip-to-hip length -->
  <xacro:property name="hip_y"       value="0.039"/>   <!-- half the hip-to-hip width -->
  <xacro:property name="hip_link"    value="0.055"/>   <!-- abduction link, pivot to leg plane -->
  <xacro:property name="upper_leg"   value="0.1075"/>
  <xacro:property name="lower_leg"   value="0.130"/>
  <xacro:property name="foot_radius" value="0.015"/>

  <!-- Nominal stand: base_link height above ground. The gait controller's
       body_height parameter defaults to the same value; ros2_control
       initial_value is derived from it below so the robot spawns standing. -->
  <xacro:property name="stand_height" value="0.16"/>

  <!-- Body shell (main chassis + head + tail), all one rigid link -->
  <xacro:property name="body_length" value="0.20"/>
  <xacro:property name="body_width"  value="0.09"/>
  <xacro:property name="body_height" value="0.06"/>
  <xacro:property name="head_length" value="0.07"/>
  <xacro:property name="head_width"  value="0.08"/>
  <xacro:property name="head_height" value="0.05"/>
  <xacro:property name="tail_length" value="0.05"/>
  <xacro:property name="body_mass"   value="1.30"/>

  <!-- Leg link visuals/masses. Hip and upper leg each house a servo. -->
  <xacro:property name="hip_box_x"  value="0.060"/>
  <xacro:property name="hip_box_z"  value="0.045"/>
  <xacro:property name="hip_mass"   value="0.15"/>
  <xacro:property name="upper_box_x" value="0.030"/>
  <xacro:property name="upper_box_y" value="0.025"/>
  <xacro:property name="upper_mass"  value="0.16"/>
  <xacro:property name="lower_box_x" value="0.020"/>
  <xacro:property name="lower_box_y" value="0.015"/>
  <xacro:property name="lower_mass"  value="0.05"/>
  <xacro:property name="foot_mass"   value="0.02"/>

  <!-- Joint limits (rad). Knee never passes through straight. -->
  <xacro:property name="hip_roll_min"  value="-0.75"/>
  <xacro:property name="hip_roll_max"  value="0.75"/>
  <xacro:property name="hip_pitch_min" value="-1.2"/>
  <xacro:property name="hip_pitch_max" value="1.6"/>
  <xacro:property name="knee_min"      value="-2.7"/>
  <xacro:property name="knee_max"      value="-0.35"/>

  <!-- 35 kg·cm class hobby servo: ~3.4 N·m stall, ~0.15 s / 60° -->
  <xacro:property name="joint_effort"   value="3.4"/>
  <xacro:property name="joint_velocity" value="7.0"/>
  <xacro:property name="joint_damping"  value="0.02"/>
  <xacro:property name="joint_friction" value="0.02"/>

  <!-- Stand pose derived from the geometry: foot straight below the hip
       pitch joint at reach h = stand_height - foot_radius (2-link IK). -->
  <xacro:property name="stand_reach" value="${stand_height - foot_radius}"/>
  <xacro:property name="stand_knee"
    value="${-acos((stand_reach**2 - upper_leg**2 - lower_leg**2) / (2*upper_leg*lower_leg))}"/>
  <xacro:property name="stand_hip_pitch"
    value="${acos((upper_leg**2 + stand_reach**2 - lower_leg**2) / (2*upper_leg*stand_reach))}"/>

  <!-- ICM-42688-P-class low-cost 6-axis IMU profile.

       The white-noise values are the datasheet RMS figures for a 100 Hz
       bandwidth (appropriate for the 200 Hz output rate below). Bias limits
       are treated as 3-sigma turn-on errors. Gazebo's slow bias process is a
       practical approximation because the real temperature history is not
       simulated. All values use REP-103 SI units. -->
  <xacro:property name="imu_update_rate" value="200.0"/>
  <xacro:property name="imu_gyro_noise_stddev" value="0.0004886921906"/>
  <xacro:property name="imu_gyro_bias_stddev" value="0.002908882087"/>
  <xacro:property name="imu_gyro_dynamic_bias_stddev" value="0.0000872664626"/>
  <xacro:property name="imu_gyro_dynamic_bias_correlation_time" value="300.0"/>
  <xacro:property name="imu_gyro_precision" value="0.001065264436"/>
  <xacro:property name="imu_accel_xy_noise_stddev" value="0.0063743225"/>
  <xacro:property name="imu_accel_z_noise_stddev" value="0.006864655"/>
  <xacro:property name="imu_accel_bias_stddev" value="0.06537766667"/>
  <xacro:property name="imu_accel_dynamic_bias_stddev" value="0.004903325"/>
  <xacro:property name="imu_accel_dynamic_bias_correlation_time" value="300.0"/>
  <xacro:property name="imu_accel_precision" value="0.00478840332"/>

  <!-- Colors -->
  <material name="yellow"><color rgba="0.95 0.75 0.10 1.0"/></material>
  <material name="dark_grey"><color rgba="0.20 0.20 0.20 1.0"/></material>
  <material name="light_grey"><color rgba="0.65 0.65 0.65 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>

  <!-- ===================== INERTIA MACROS ===================== -->

  <xacro:macro name="box_inertial" params="m x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
               iyy="${2*m*r*r/5}" iyz="0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== LEG MACRO ===================== -->
  <!--
    prefix : FL | FR | RL | RR
    x_sign : +1 front | -1 rear
    y_sign : +1 left  | -1 right
  -->
  <xacro:macro name="leg" params="prefix x_sign y_sign">

    <!-- HIP ROLL (abduction) — pivot on the body side -->
    <joint name="${prefix}_hip_roll_joint" type="revolute">
      <parent link="base_link"/>
      <child  link="${prefix}_hip_link"/>
      <origin xyz="${x_sign*hip_x} ${y_sign*hip_y} 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${hip_roll_min}" upper="${hip_roll_max}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <!-- Hip link: servo block carrying the leg plane outboard -->
    <link name="${prefix}_hip_link">
      <xacro:box_inertial m="${hip_mass}" x="${hip_box_x}" y="${hip_link}" z="${hip_box_z}">
        <origin xyz="0 ${y_sign*hip_link/2} 0" rpy="0 0 0"/>
      </xacro:box_inertial>
      <visual>
        <origin xyz="0 ${y_sign*hip_link/2} 0" rpy="0 0 0"/>
        <geometry><box size="${hip_box_x} ${hip_link} ${hip_box_z}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 ${y_sign*hip_link/2} 0" rpy="0 0 0"/>
        <geometry><box size="${hip_box_x} ${hip_link} ${hip_box_z}"/></geometry>
      </collision>
    </link>

    <!-- HIP PITCH — in the leg plane, outboard end of the hip link -->
    <joint name="${prefix}_hip_pitch_joint" type="revolute">
      <parent link="${prefix}_hip_link"/>
      <child  link="${prefix}_upper_leg_link"/>
      <origin xyz="0 ${y_sign*hip_link} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${hip_pitch_min}" upper="${hip_pitch_max}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <link name="${prefix}_upper_leg_link">
      <xacro:box_inertial m="${upper_mass}" x="${upper_box_x}" y="${upper_box_y}" z="${upper_leg}">
        <origin xyz="0 0 ${-upper_leg/2}" rpy="0 0 0"/>
      </xacro:box_inertial>
      <visual>
        <origin xyz="0 0 ${-upper_leg/2}" rpy="0 0 0"/>
        <geometry><box size="${upper_box_x} ${upper_box_y} ${upper_leg}"/></geometry>
        <material name="yellow"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-upper_leg/2}" rpy="0 0 0"/>
        <geometry><box size="${upper_box_x} ${upper_box_y} ${upper_leg}"/></geometry>
      </collision>
    </link>

    <!-- KNEE -->
    <joint name="${prefix}_knee_joint" type="revolute">
      <parent link="${prefix}_upper_leg_link"/>
      <child  link="${prefix}_lower_leg_link"/>
      <origin xyz="0 0 ${-upper_leg}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${knee_min}" upper="${knee_max}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <link name="${prefix}_lower_leg_link">
      <xacro:box_inertial m="${lower_mass}" x="${lower_box_x}" y="${lower_box_y}" z="${lower_leg}">
        <origin xyz="0 0 ${-lower_leg/2}" rpy="0 0 0"/>
      </xacro:box_inertial>
      <visual>
        <origin xyz="0 0 ${-lower_leg/2}" rpy="0 0 0"/>
        <geometry><box size="${lower_box_x} ${lower_box_y} ${lower_leg}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-lower_leg/2}" rpy="0 0 0"/>
        <geometry><box size="${lower_box_x} ${lower_box_y} ${lower_leg}"/></geometry>
      </collision>
    </link>

    <!-- FOOT (fixed rubber ball) -->
    <joint name="${prefix}_foot_joint" type="fixed">
      <parent link="${prefix}_lower_leg_link"/>
      <child  link="${prefix}_foot_link"/>
      <origin xyz="0 0 ${-lower_leg}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_foot_link">
      <xacro:sphere_inertial m="${foot_mass}" r="${foot_radius}"/>
      <visual>
        <geometry><sphere radius="${foot_radius}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><sphere radius="${foot_radius}"/></geometry>
      </collision>
    </link>

    <gazebo reference="${prefix}_foot_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>

    <!-- Foot contact sensor (gz-sim); available for contact-based stance
         detection, not bridged to ROS by default. The URDF→SDF conversion
         lumps the fixed foot link into the lower leg and renames its
         collision, so the sensor must name the lumped collision. -->
    <gazebo reference="${prefix}_lower_leg_link">
      <sensor name="${prefix}_foot_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>${prefix}_foot_contact</topic>
        <contact>
          <collision>${prefix}_lower_leg_link_fixed_joint_lump__${prefix}_foot_link_collision_1</collision>
        </contact>
      </sensor>
    </gazebo>

  </xacro:macro>

  <!-- ===================== BODY ===================== -->

  <link name="base_link">
    <xacro:box_inertial m="${body_mass}" x="${body_length + head_length}" y="${body_width}" z="${body_height}">
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
    <!-- main chassis -->
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <!-- head -->
    <visual>
      <origin xyz="${body_length/2 + head_length/2} 0 ${(body_height - head_height)/2}" rpy="0 0 0"/>
      <geometry><box size="${head_length} ${head_width} ${head_height}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="${body_length/2 + head_length/2} 0 ${(body_height - head_height)/2}" rpy="0 0 0"/>
      <geometry><box size="${head_length} ${head_width} ${head_height}"/></geometry>
    </collision>
    <!-- tail -->
    <visual>
      <origin xyz="${-(body_length/2 + tail_length/2)} 0 ${(body_height - head_height)/2}" rpy="0 0 0"/>
      <geometry><box size="${tail_length} ${head_width} ${head_height}"/></geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <!-- base_footprint: base_link projected onto the ground (REP-105) -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="base_footprint"/>
    <origin xyz="0 0 ${-stand_height}" rpy="0 0 0"/>
  </joint>
  <link name="base_footprint"/>

  <!-- IMU at the body centre -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <!-- Camera on the front face of the head -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${body_length/2 + head_length} 0 ${(body_height - head_height)/2 + 0.01}" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="-0.005 0 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.05 0.015"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Optical frame (z forward, x right, y down) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_link_optical"/>

  <!-- ===================== LEGS ===================== -->

  <xacro:leg prefix="FL" x_sign="1"  y_sign="1"/>
  <xacro:leg prefix="FR" x_sign="1"  y_sign="-1"/>
  <xacro:leg prefix="RL" x_sign="-1" y_sign="1"/>
  <xacro:leg prefix="RR" x_sign="-1" y_sign="-1"/>

  <!-- ===================== ROS2_CONTROL ===================== -->
  <!-- gz_ros2_control binds each joint to the GazeboSimSystem hardware
       interface. Position commands are tracked with a velocity loop whose
       gain is the plugin's position_proportional_gain parameter (set in
       config/ros2_control.yaml); joint effort limits above act as servo
       stall torque. initial_value puts the robot in the stand pose so it
       spawns standing instead of collapsing while the controllers load. -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <xacro:macro name="leg_joints_hw" params="prefix">
      <joint name="${prefix}_hip_roll_joint">
        <command_interface name="position">
          <param name="min">${hip_roll_min}</param>
          <param name="max">${hip_roll_max}</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}_hip_pitch_joint">
        <command_interface name="position">
          <param name="min">${hip_pitch_min}</param>
          <param name="max">${hip_pitch_max}</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">${stand_hip_pitch}</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}_knee_joint">
        <command_interface name="position">
          <param name="min">${knee_min}</param>
          <param name="max">${knee_max}</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">${stand_knee}</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

    <xacro:leg_joints_hw prefix="FL"/>
    <xacro:leg_joints_hw prefix="FR"/>
    <xacro:leg_joints_hw prefix="RL"/>
    <xacro:leg_joints_hw prefix="RR"/>
  </ros2_control>

  <!-- ===================== GAZEBO PLUGINS (gz-sim) ===================== -->

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find quadruped_gazebo)/config/ros2_control.yaml</parameters>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  </gazebo>

  <!-- Low-cost commercial 6-axis IMU (Gazebo Harmonic SDFormat style).

       This models an ICM-42688-P configured for +/-2000 deg/s and +/-16 g.
       The simulator-provided orientation remains enabled for compatibility
       with robot_localization; the commercial part itself measures angular
       velocity and linear acceleration, not absolute orientation. -->
  <xacro:macro name="imu_axis_noise" params="stddev bias_stddev dyn_bias_stddev dyn_bias_tau precision">
    <noise type="gaussian_quantized">
      <mean>0</mean><stddev>${stddev}</stddev>
      <bias_mean>0</bias_mean><bias_stddev>${bias_stddev}</bias_stddev>
      <dynamic_bias_stddev>${dyn_bias_stddev}</dynamic_bias_stddev>
      <dynamic_bias_correlation_time>${dyn_bias_tau}</dynamic_bias_correlation_time>
      <precision>${precision}</precision>
    </noise>
  </xacro:macro>
  <xacro:macro name="imu_gyro_noise">
    <xacro:imu_axis_noise stddev="${imu_gyro_noise_stddev}" bias_stddev="${imu_gyro_bias_stddev}"
      dyn_bias_stddev="${imu_gyro_dynamic_bias_stddev}" dyn_bias_tau="${imu_gyro_dynamic_bias_correlation_time}"
      precision="${imu_gyro_precision}"/>
  </xacro:macro>
  <xacro:macro name="imu_accel_noise" params="stddev">
    <xacro:imu_axis_noise stddev="${stddev}" bias_stddev="${imu_accel_bias_stddev}"
      dyn_bias_stddev="${imu_accel_dynamic_bias_stddev}" dyn_bias_tau="${imu_accel_dynamic_bias_correlation_time}"
      precision="${imu_accel_precision}"/>
  </xacro:macro>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>${imu_update_rate}</update_rate>
      <topic>imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <imu>
        <angular_velocity>
          <x><xacro:imu_gyro_noise/></x>
          <y><xacro:imu_gyro_noise/></y>
          <z><xacro:imu_gyro_noise/></z>
        </angular_velocity>
        <linear_acceleration>
          <x><xacro:imu_accel_noise stddev="${imu_accel_xy_noise_stddev}"/></x>
          <y><xacro:imu_accel_noise stddev="${imu_accel_xy_noise_stddev}"/></y>
          <z><xacro:imu_accel_noise stddev="${imu_accel_z_noise_stddev}"/></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Front camera + depth camera (Gazebo Harmonic SDFormat style)

       Both sensors are rigidly attached to camera_link at an identical zero
       pose, so the RGB frame and the ground-truth depth frame observe the
       scene from exactly the same viewpoint. The poses are written out rather
       than left to default so the co-location is explicit: monocular depth is
       compared pixel-for-pixel against the depth sensor, and any offset
       between the two would show up as a scale or parallax error that looks
       like a model defect.

       front_camera's image is genuinely in the optical convention (z forward,
       x right, y down), so it is stamped camera_link_optical. depth_camera's
       auto-generated PointCloud2 (the gz-sim depth_camera sensor's own
       `<topic>/points`, not depth_image_proc) is different: gz-sim computes
       those XYZ values in the body/REP-103 convention (x forward, y left,
       z up) regardless of gz_frame_id, so it must stay stamped camera_link.
       Verified empirically on a running sim: /depth_camera/depth_image/points
       has x always positive (depth) with y/z spanning the FOV, while
       /depth/points (Metric3D -> depth_image_proc, genuinely optical) has z
       always positive instead. Mislabeling depth_camera as camera_link_optical
       relabels the header without changing the underlying data, so anything
       that trusts the frame_id (TF, RViz, ground_plane_estimation) sees it
       rotated 90 degrees relative to every optical-frame cloud. -->
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>front_camera/image_raw</topic>
      <gz_frame_id>camera_link_optical</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
    </sensor>
    <sensor name="depth_camera" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>depth_camera/depth_image</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <camera>
        <!-- FOV and clip planes match front_camera so the two views are
             identical up to resolution. -->
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>160</width>
          <height>120</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
