<?xml version="1.0"?>
<package format="3">
  <name>quadruped_kinematics</name>
  <version>0.1.0</version>
  <description>Spot Micro leg and body kinematics shared by the gait controller and leg odometry (pure numpy, no ROS at runtime)</description>

  <maintainer email="kucukkomurler.alper@gmail.com">Alper Kucukkomurler</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
