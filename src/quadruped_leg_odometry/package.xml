<?xml version="1.0"?>
<package format="3">
  <name>quadruped_leg_odometry</name>
  <version>0.0.1</version>
  <description>Leg-kinematics + IMU odometry (LKO) — publishes /odom_lko from /joint_states and /imu/data</description>

  <maintainer email="kucukkomurler.alper@gmail.com">Alper Kucukkomurler</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>quadruped_kinematics</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
