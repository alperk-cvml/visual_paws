# Stereo (ZED 2i) Gazebo profile: stereo pipeline Step 1.
# Paired with docker-compose-stereo-sim.yaml.
#
# Spawns the robot with the simulated ZED 2i rig (camera_rig:=stereo) on the
# textured v0_geometry benchmark and publishes the canonical stereo topics:
#   /stereo/{left,right}/image_rect + camera_info   15 Hz, identical stamps
#   /stereo/depth_gt/image_raw + camera_info        ground truth, left-registered
#   /stereo/imu/data                                200 Hz, camera IMU
# Nothing consumes them yet: stereo_depth (Step 2) turns the GT depth into
# ZED-like /depth/image_raw.

USE_SIM_TIME=true
LOCALIZATION_MODE=ground_truth

SIM_BENCHMARK_SCENARIO=v0_geometry
SIM_BENCHMARK_SEED=config
SIM_BENCHMARK_OUTPUT_DIR=/work/ws/build/simulation_benchmark

GAZEBO_LAUNCH_FILE=simulation_benchmark.launch.py
GAZEBO_LAUNCH_ARGS=scenario:=${SIM_BENCHMARK_SCENARIO:-v0_geometry} seed:=${SIM_BENCHMARK_SEED:-config} output_dir:=${SIM_BENCHMARK_OUTPUT_DIR:-/work/ws/build/simulation_benchmark} camera_rig:=stereo textures:=true

# The 229 g camera on the nose moves the robot's centre of mass ~1.1 cm
# forward. Without this, turning in place loses ~10% of the commanded yaw and
# body roll/pitch roughly doubles (headless check, 2026-11-19); -0.011 brings
# both back to the camera-less baseline.
GAIT_BODY_X=-0.011
